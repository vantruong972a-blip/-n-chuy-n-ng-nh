# Địa chỉ FastAPI khi chạy `npm run dev` (mặc định http://127.0.0.1:8000)
VITE_BACKEND_URL=http://127.0.0.1:8000
# Khi frontend và backend KHÁC địa chỉ (không dùng proxy), đặt địa chỉ gốc của API tại đây (cần bật CORS ở backend)
# VITE_API_BASE=https://api.example.vn
# Thông tin liên hệ hiển thị ở chân trang (để trống = không hiển thị)
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_REPO_URL=
